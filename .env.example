# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API). La clé "anon" est publique par conception :
# ce sont les règles RLS de la base qui protègent les données.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Clé publique VAPID des notifications push (la clé privée va dans les secrets Supabase,
# jamais ici). Voir README, section « Notifications ».
VITE_VAPID_PUBLIC_KEY=
